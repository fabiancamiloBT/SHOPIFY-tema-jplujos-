.171875 61.050781 179.96875 12.847656 120.507812 12.847656 C 61.050781 12.847656 12.847656 61.050781 12.847656 120.507812 C 12.847656 179.96875 61.050781 228.171875 120.507812 228.171875 Z M 120.507812 228.171875 \" fill-opacity=\"1\" fill-rule=\"evenodd\"><\/path><\/g><\/g><\/g><path fill=\"#009111\" d=\"M 189.667969 256.933594 C 228.066406 256.933594 259.191406 225.804688 259.191406 187.40625 C 259.191406 149.011719 228.066406 117.882812 189.667969 117.882812 C 151.269531 117.882812 120.144531 149.011719 120.144531 187.40625 C 120.144531 225.804688 151.269531 256.933594 189.667969 256.933594 Z M 189.667969 256.933594 \" fill-opacity=\"1\" fill-rule=\"evenodd\"><\/path><\/svg>\n  Stock disponible, recíbelo el <span id=\"fechas\" style=\"font-weight: bold; color: #ffffff;\"> <\/span>\n<\/div>\n\n<script>\n  document.addEventListener(\"DOMContentLoaded\", function () {\n      let currentDate = new Date();\n      let dates = [];\n      let daysToAdd = 3;\n\n      \/\/ Encontrar los próximos dos días hábiles\n      while (dates.length < 2) {\n          let nextDate = new Date(currentDate);\n          nextDate.setDate(currentDate.getDate() + daysToAdd);\n\n          \/\/ Obtener el día de la semana (0: Domingo, 6: Sábado)\n          let dayOfWeek = nextDate.getDay();\n\n          \/\/ Solo agregar si no es Sábado (6) o Domingo (0)\n          if (dayOfWeek !== 6 && dayOfWeek !== 0) {\n              const formattedDate = `${nextDate.getDate()} ${nextDate.toLocaleString('es-ES', { month: 'short' }).charAt(0).toUpperCase() + nextDate.toLocaleString('es-ES', { month: 'short' }).slice(1)}`;\n              dates.push(formattedDate);\n          }\n\n          daysToAdd++;\n      }\n\n      \/\/ Mostrar las fechas en el span de \"fechas\"\n      document.getElementById(\"fechas\").textContent = `${dates[0]} - ${dates[1]}`;\n  });\n<\/script>"}},"buy_buttons":{"type":"buy_buttons","settings":{"show_dynamic_checkout":false,"show_gift_card_recipient":false}},"collapsible_tab_hQx4bd":{"type":"collapsible_tab","settings":{"heading":"😩 ¿Tus tapetes parecen una alfombra vieja?","icon":"none","content":"<p>Olvídate del aspecto desgastado. Nuestros tapetes JP Lujos y Accesorios están diseñados para <strong>transformar por completo el interior de tu carro<\/strong>. Con un diseño moderno y un acabado de alta calidad, le darás a tu vehículo un aspecto renovado y elegante. Pasa del caos a la perfección con un simple cambio que hace una gran diferencia visual.<\/p>","page":""}},"collapsible_tab_Wdxgzt":{"type":"collapsible_tab","settings":{"heading":"💪 ¿Quieres tapetes que duren mucho tiempo?","icon":"none","content":"<p>La durabilidad es una de nuestras principales promesas. Nuestros tapetes están fabricados con <strong>PVC industrial<\/strong>, un material extremadamente robusto, lo que les da una <strong>durabilidad brutal<\/strong>. Son <strong>resistentes al barro, al agua, y al desgaste<\/strong> diario. Diseñados para soportar el uso constante sin perder su forma ni su color, te garantizamos que con una sola compra, te olvidarás de tener que reemplazarlos en mucho tiempo.<\/p>","page":""}},"collapsible_tab_mjpBep":{"type":"collapsible_tab","settings":{"heading":"🚫 ¿Te preocupa que se muevan mientras manejas?","icon":"none","content":"<p>Tu seguridad es nuestra prioridad. Por eso, nuestros tapetes cuentan con un <strong>material antideslizante<\/strong> en su base, que se <strong>adhiere de forma segura al piso del carro<\/strong>. Esto evita por completo que se <strong>corran, se arruguen o se enrosquen<\/strong> debajo de los pedales. Conduce con la tranquilidad de saber que tus tapetes se mantendrán en su lugar, sin importar las condiciones.<\/p>","page":""}},"collapsible_tab_x3H3nr":{"type":"collapsible_tab","settings":{"heading":"✅ 3 Meses de Garantía Real","icon":"none","content":"<p>Tu compra está protegida. Ofrecemos <strong>garantía de 3 meses<\/strong> por defectos de fábrica o funcionamiento. Si el KIT presenta algún fallo dentro de este período, te lo <strong>cambiamos sin costo adicional<\/strong>.<br\/><br\/>Nuestra prioridad es que tengas un producto confiable y duradero, con el respaldo que mereces.<\/p>","page":""}},"collapsible_tab_4gnUX6":{"type":"collapsible_tab","settings":{"heading":"🤝 Devoluciones y cambios gratuitos","icon":"none","content":"<p>Si por cualquier motivo no estás satisfecho con tu compra, puedes solicitar una <strong>devolución dentro de los primeros 7 días<\/strong> después de recibir el producto.<br\/><br\/>El artículo debe estar en perfectas condiciones, sin uso y con su empaque original.<br\/><br\/>Una vez recibido y verificado, <strong>te haremos un reembolso completo o cambio<\/strong>, según prefieras.<br\/><br\/>Nuestro objetivo es que compres con total confianza y tranquilidad.<\/p>","page":""}}},"block_order":["f9cd6948-b8c7-489f-b0bb-8b395810cd18","vendor","title","custom_liquid_kJGQaH","price","custom_liquid_hDMEeg","buy_buttons","collapsible_tab_hQx4bd","collapsible_tab_Wdxgzt","collapsible_tab_mjpBep","collapsible_tab_x3H3nr","collapsible_tab_4gnUX6"],"custom_css":[".product__title > * {margin: 0; font-size: 22.3px;}",".price .price-item {display: inline-block; margin: 0 1rem 0 0; color: #24cd24; font-weight: bold;}",".price--on-sale .price-item--regular {text-decoration: line-through; color: rgba(var(--color-foreground), 0.75); font-size: 1.3rem; color: red;}",".accordion__title {display: inline-block; max-width: calc(100% - 6rem); min-height: 1.6rem; margin: 0; word-break: break-word; font-size: 16px;}"],"settings":{"enable_sticky_info":true,"media_size":"large","constrain_to_viewport":false,"media_fit":"contain","gallery_layout":"stacked","media_position":"left","image_zoom":"none","mobile_thumbnails":"hide","hide_variants":true,"enable_video_looping":false,"padding_top":0,"padding_bottom":16}},"pagefly_section_6q7MkX":{"type":"pagefly-section","name":"PageFly Section","settings":{"section_id":"pf-ea604a63"}},"custom_liquid_PxAUYj":{"type":"custom-liqui